{
  "mcpServers": {
    "aruba-central-mcp": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "aruba-central-mcp"
      ],
      "env": {
        "ARUBA_CENTRAL_BASE_URL": "${ARUBA_CENTRAL_BASE_URL:-}",
        "ARUBA_CENTRAL_CLIENT_ID": "${ARUBA_CENTRAL_CLIENT_ID:-}",
        "ARUBA_CENTRAL_CLIENT_SECRET": "${ARUBA_CENTRAL_CLIENT_SECRET:-}",
        "ARUBA_CLASSIC_BASE_URL": "${ARUBA_CLASSIC_BASE_URL:-}",
        "ARUBA_CLASSIC_CLIENT_ID": "${ARUBA_CLASSIC_CLIENT_ID:-}",
        "ARUBA_CLASSIC_CLIENT_SECRET": "${ARUBA_CLASSIC_CLIENT_SECRET:-}",
        "ARUBA_CLASSIC_TOKEN_FILE": "${ARUBA_CLASSIC_TOKEN_FILE:-}"
      }
    }
  }
}
